/-!
# TurtleO2 -- kernel-checked verification of a pass-substitution certificate

Checker for the finite obligations of the unboundedness proof of turtle programs on
Penrose rhomb tilings (`proof_unbounded.md`, `verify_cert.py`, `indep_check.py`):

* frames: the child frames (type, rotation k, translation t) of the four standard triangles
  agree with the Robinson-triangle substitution σ (exact arithmetic in Z[ζ]);
* O3: closure / consistency of the pass table (types, parities, children);
* O2: the port identities (a), (b), (c) of every pass family at the two lowest levels of its
  parity class above the base level B.  By Lemma 1 of the proof they then hold at all levels.

Standalone Lean 4 (no Mathlib).  The data section (`cert`) is generated by LeanAssist from the
certificate JSON; the theorem at the end is checked by `decide` (kernel) or `native_decide`.

Port and pass families are looked up through a balanced binary search tree on their ids
(`BTree`, also used by the O1 checker for the directed edges of a supertile): a linear search
over 1560 port families (cert_SRSRSRSRSSR) is too slow for kernel evaluation.  The tree is built
by a fuel-bounded merge sort and a balanced construction (structural recursion only, which the
kernel can evaluate); the checker verifies that the ids are pairwise distinct and that the tree
holds every entry.
-/

namespace TurtleO2

/-- Element of Z[ζ], ζ = e^{2πi/5}, as integer coordinates in the basis 1, ζ, ζ², ζ³, ζ⁴,
taken modulo (1,1,1,1,1).  `canon` makes the last coordinate 0. -/
structure Z5 where
  a : Int
  b : Int
  c : Int
  d : Int
  e : Int
deriving DecidableEq, Repr

namespace Z5

def canon (k : Z5) : Z5 := ⟨k.a - k.e, k.b - k.e, k.c - k.e, k.d - k.e, 0⟩

def add (k l : Z5) : Z5 := canon ⟨k.a + l.a, k.b + l.b, k.c + l.c, k.d + l.d, k.e + l.e⟩

def sub (k l : Z5) : Z5 := canon ⟨k.a - l.a, k.b - l.b, k.c - l.c, k.d - l.d, k.e - l.e⟩

/-- multiplication by φ = 1 + ζ + ζ⁴ : out_j = K_j + K_{j-1} + K_{j+1} -/
def mulphi (k : Z5) : Z5 :=
  canon ⟨k.a + k.e + k.b, k.b + k.a + k.c, k.c + k.b + k.d, k.d + k.c + k.e, k.e + k.d + k.a⟩

/-- multiplication by ρ = -ζ³ (rotation by 36°): out_j = -K_{j-3} -/
def rot36 (k : Z5) : Z5 := canon ⟨-k.c, -k.d, -k.e, -k.a, -k.b⟩

def beq (k l : Z5) : Bool := canon k == canon l

def zero : Z5 := ⟨0, 0, 0, 0, 0⟩

end Z5

def iter {α : Type} (f : α → α) : Nat → α → α
  | 0, x => x
  | n + 1, x => iter f n (f x)

def rotN (k : Nat) (v : Z5) : Z5 := iter Z5.rot36 k v
def phiN (n : Nat) (v : Z5) : Z5 := iter Z5.mulphi n v
def phi2 (v : Z5) : Z5 := Z5.mulphi (Z5.mulphi v)

/-- ρ^k · 1 -/
def unit (k : Nat) : Z5 := rotN k ⟨1, 0, 0, 0, 0⟩

/-- standard marked triangle of type (col, sign): apex 0, then B, C -/
def stdTriangle (col : Nat) (sign : Int) : Z5 × Z5 × Z5 :=
  let b := unit 0
  let c := if col == 0 then unit 1 else unit 3
  if sign > 0 then (Z5.zero, b, c) else (Z5.zero, c, b)

/-- children (col, A, B, C) of a triangle under σ, in slot order (coordinates of the inflated parent) -/
def subdivide (col : Nat) (A B C : Z5) : List (Nat × Z5 × Z5 × Z5) :=
  let A2 := Z5.mulphi A
  let B2 := Z5.mulphi B
  let C2 := Z5.mulphi C
  if col == 0 then
    let P := Z5.add A2 (Z5.sub B A)
    [(0, C2, P, B2), (1, P, C2, A2)]
  else
    let Q := Z5.add B2 (Z5.sub A B)
    let R := Z5.add B2 (Z5.sub C B)
    [(1, R, C2, A2), (1, Q, R, B2), (0, R, Q, A2)]

/-! ## balanced binary search tree on `Nat` keys

Fuel-bounded merge sort and balanced construction, structural recursion only (definitions by
well-founded recursion do not reduce in the kernel).  `ofList` checks that the sorted keys are
strictly increasing (no duplicate key, and enough fuel for the sort) and that the tree holds
every entry (enough fuel for the construction), so a lookup miss means that the key is absent. -/

inductive BTree (α : Type) where
  | leaf
  | node (l : BTree α) (key : Nat) (val : α) (r : BTree α)

namespace BTree

variable {α : Type}

def split : List (Nat × α) → List (Nat × α) × List (Nat × α)
  | [] => ([], [])
  | [x] => ([x], [])
  | x :: y :: tl =>
    let (a, b) := split tl
    (x :: a, y :: b)

def mergeBy : Nat → List (Nat × α) → List (Nat × α) → List (Nat × α)
  | 0, xs, ys => xs ++ ys
  | _ + 1, [], ys => ys
  | _ + 1, xs, [] => xs
  | n + 1, x :: xs, y :: ys =>
    if x.1 ≤ y.1 then x :: mergeBy n xs (y :: ys) else y :: mergeBy n (x :: xs) ys

def msort : Nat → List (Nat × α) → List (Nat × α)
  | 0, xs => xs
  | n + 1, xs =>
    match xs with
    | [] => []
    | [x] => [x]
    | _ =>
      let (a, b) := split xs
      mergeBy xs.length (msort n a) (msort n b)

def sortedStrict : List (Nat × α) → Bool
  | [] => true
  | [_] => true
  | x :: y :: tl => x.1 < y.1 && sortedStrict (y :: tl)

def build : Nat → List (Nat × α) → BTree α
  | 0, _ => leaf
  | n + 1, xs =>
    match xs with
    | [] => leaf
    | _ =>
      let h := xs.length / 2
      match xs.drop h with
      | [] => leaf
      | (k, v) :: rest => node (build n (xs.take h)) k v (build n rest)

def size : BTree α → Nat
  | leaf => 0
  | node l _ _ r => l.size + 1 + r.size

def find (t : BTree α) (k : Nat) : Option α :=
  match t with
  | leaf => none
  | node l key v r => if k < key then find l k else if key < k then find r k else some v

/-- the tree of a key/value list; `none` when two entries share a key -/
def ofList (xs : List (Nat × α)) : Option (BTree α) :=
  let es := msort 64 xs
  if !(sortedStrict es) then none
  else
    let t := build 64 es
    if t.size != es.length then none else some t

end BTree

/-- a crossing: leg tail → head, command index -/
structure Cross where
  tail : Z5
  head : Z5
  i : Nat
deriving Repr

def Cross.beq (x y : Cross) : Bool := Z5.beq x.tail y.tail && Z5.beq x.head y.head && x.i == y.i

/-- port family -/
structure Port where
  id : Nat
  col : Nat
  sign : Int
  parity : Nat
  ref : Cross
  dtail : Z5
  dhead : Z5
deriving Repr

structure Child where
  slot : Nat
  entry : Nat
  exit : Nat
deriving Repr

structure Pass where
  id : Nat
  out : Nat
  children : List Child
deriving Repr

/-- child frame: child = ρ^k (standard child of type (ccol, csign)) + t -/
structure Frame where
  ccol : Nat
  csign : Int
  k : Nat
  t : Z5
deriving Repr

structure Cert where
  B : Nat
  ports : List Port
  passes : List Pass
  frames : List (Nat × Int × List Frame)
deriving Repr

/-- the certificate with its port and pass families indexed by id -/
structure Idx where
  B : Nat
  ports : BTree Port
  passes : BTree Pass
  frames : List (Nat × Int × List Frame)

/-- `none` when two port families or two pass families share an id -/
def Cert.index (c : Cert) : Option Idx :=
  match BTree.ofList (c.ports.map (fun p => (p.id, p))), BTree.ofList (c.passes.map (fun p => (p.id, p))) with
  | some tp, some tq => some { B := c.B, ports := tp, passes := tq, frames := c.frames }
  | _, _ => none

def findPort (ix : Idx) (pid : Nat) : Option Port := BTree.find ix.ports pid
def findPass (ix : Idx) (pid : Nat) : Option Pass := BTree.find ix.passes pid
def findFrames (ix : Idx) (col : Nat) (sign : Int) : Option (List Frame) :=
  (ix.frames.find? (fun f => f.1 == col && f.2.1 == sign)).map (fun f => f.2.2)

/-- lowest level ≥ B of parity q -/
def Rq (B q : Nat) : Nat := if B % 2 == q then B else B + 1

/-- the port at level m (m ≡ q, m ≥ R(q)): x ← φ² x + δ, (m − R(q))/2 times -/
def portAt (B : Nat) (p : Port) (m : Nat) : Cross :=
  let s := (m - Rq B p.parity) / 2
  { tail := iter (fun x => Z5.add (phi2 x) p.dtail) s p.ref.tail,
    head := iter (fun x => Z5.add (phi2 x) p.dhead) s p.ref.head,
    i := p.ref.i }

/-- G_{slot,m} : child frame (level m−1) → parent frame (level m): ρ^k x + φ^{m−1} t -/
def G (fr : Frame) (m : Nat) (x : Z5) : Z5 := Z5.add (rotN fr.k x) (phiN (m - 1) fr.t)

def GCross (fr : Frame) (m : Nat) (x : Cross) : Cross := ⟨G fr m x.tail, G fr m x.head, x.i⟩

/-- the crossing of port `pid` at level m−1, placed into the parent frame through `slot` -/
def placed (ix : Idx) (frs : List Frame) (slot pid m : Nat) : Option Cross :=
  match findPort ix pid, frs[slot]? with
  | some p, some fr => some (GCross fr m (portAt ix.B p (m - 1)))
  | _, _ => none

def crossEq (x y : Option Cross) : Bool :=
  match x, y with
  | some a, some b => Cross.beq a b
  | _, _ => false

/-- identities (b) along the children and (c) at the end -/
def chainOK (ix : Idx) (frs : List Frame) (m : Nat) (outCross : Cross) : Child → List Child → Bool
  | prev, [] => crossEq (some outCross) (placed ix frs prev.slot prev.exit m)
  | prev, nxt :: tl =>
      crossEq (placed ix frs prev.slot prev.exit m) (placed ix frs nxt.slot nxt.entry m) && chainOK ix frs m outCross nxt tl

def checkPassLevel (ix : Idx) (p : Pass) (m : Nat) : Bool :=
  match findPort ix p.id, findPort ix p.out with
  | some pin, some pout =>
    match findFrames ix pin.col pin.sign, p.children with
    | some frs, ch0 :: rest =>
        crossEq (some (portAt ix.B pin m)) (placed ix frs ch0.slot ch0.entry m) &&
        chainOK ix frs m (portAt ix.B pout m) ch0 rest
    | _, _ => false
  | _, _ => false

/-- the two lowest levels of parity q above B -/
def levelsFor (B q : Nat) : List Nat :=
  let m1 := if (B + 1) % 2 == q then B + 1 else B + 2
  [m1, m1 + 2]

def checkPassO2 (ix : Idx) (p : Pass) : Bool :=
  match findPort ix p.id with
  | some pin => (levelsFor ix.B pin.parity).all (checkPassLevel ix p)
  | none => false

def checkO2 (c : Cert) (ix : Idx) : Bool := c.passes.all (checkPassO2 ix)

/-- O3: exit port of the same type and parity; children exist, have the type of their slot and the
opposite parity, their entry is a pass of the table with the stated exit; consecutive slots differ -/
def childOK (ix : Idx) (pin : Port) (frs : List Frame) (ch : Child) : Bool :=
  match findPort ix ch.entry, findPort ix ch.exit, frs[ch.slot]?, findPass ix ch.entry with
  | some a, some b, some fr, some pa =>
      a.col == fr.ccol && a.sign == fr.csign && b.col == fr.ccol && b.sign == fr.csign &&
      a.parity == 1 - pin.parity && b.parity == 1 - pin.parity && pa.out == ch.exit
  | _, _, _, _ => false

def slotsDiffer : List Child → Bool
  | [] => true
  | [_] => true
  | x :: y :: tl => (x.slot != y.slot) && slotsDiffer (y :: tl)

def checkPassO3 (ix : Idx) (p : Pass) : Bool :=
  match findPort ix p.id, findPort ix p.out with
  | some pin, some pout =>
    match findFrames ix pin.col pin.sign with
    | some frs =>
        pin.col == pout.col && pin.sign == pout.sign && pin.parity == pout.parity &&
        p.children.length > 0 && p.children.all (childOK ix pin frs) && slotsDiffer p.children
    | none => false
  | _, _ => false

def checkO3 (c : Cert) (ix : Idx) : Bool := c.passes.all (checkPassO3 ix)

/-- δ is consistent with a unit leg: δ_head − δ_tail = (head − tail) − φ²(head − tail) -/
def portDeltaOK (p : Port) : Bool :=
  let leg := Z5.sub p.ref.head p.ref.tail
  Z5.beq (Z5.sub p.dhead p.dtail) (Z5.sub leg (phi2 leg))

def checkPorts (c : Cert) : Bool := c.ports.all portDeltaOK

/-- frame j describes child j of the standard triangle: A = t, B − A = ρ^k std.B, C − A = ρ^k std.C -/
def frameOK (child : Nat × Z5 × Z5 × Z5) (fr : Frame) : Bool :=
  let (ccol, A, B, C) := child
  let (_, sb, sc) := stdTriangle fr.ccol fr.csign
  ccol == fr.ccol && Z5.beq A fr.t && Z5.beq (Z5.sub B A) (rotN fr.k sb) && Z5.beq (Z5.sub C A) (rotN fr.k sc)

def framesOK (c : Cert) : Bool :=
  c.frames.all (fun f =>
    let (A, B, C) := stdTriangle f.1 f.2.1
    let ch := subdivide f.1 A B C
    ch.length == f.2.2.length && (List.zip ch f.2.2).all (fun x => frameOK x.1 x.2))

def checkCertificate (c : Cert) : Bool :=
  match c.index with
  | none => false
  | some ix => framesOK c && checkPorts c && checkO3 c ix && checkO2 c ix

/-- sanity: φ² = φ + 1 on a sample, ρ^10 = 1 -/
theorem phi_sq_sample : phi2 ⟨2, -3, 0, 1, 0⟩ = Z5.add (Z5.mulphi ⟨2, -3, 0, 1, 0⟩) (Z5.canon ⟨2, -3, 0, 1, 0⟩) := by decide
theorem rot_ten : rotN 10 ⟨2, -3, 0, 1, 0⟩ = Z5.canon ⟨2, -3, 0, 1, 0⟩ := by decide

end TurtleO2
/-!
# TurtleO1 -- kernel-checked base simulation (obligation O1) of a pass-substitution certificate

O1 of `proof_unbounded.md`: for every pass family π of parity B mod 2, in the standard level-B
supertile X of type τ(π), the crossing port(π.in, B) leads into a rhomb owned by X; starting
there the turtle performs exactly N(π, B) S-moves, the first N − 1 between rhombs owned by X, and
the N-th is the crossing port(π.out, B), which leads to a rhomb not owned by X.

Everything is recomputed from the definitions (same specification as `verify_cert.py`,
class `Supertile`, and `lib.wl`, `ptRhombs "Ghost" -> True` / `ptNav`):

* the fine triangles of X: `subdivide` applied B times to the standard marked triangle;
* ownership: every positively oriented fine triangle (A, B, C) owns the rhomb (A, B, B + C − A, C)
  (its mirror half is the ghost half when the negative triangle is not in X);
* navigation by directed edge keys: the rhomb on the far side of the leg a → b is the one that has
  the directed edge b → a in its counter-clockwise order;
* turtle: state (rhomb, edge e ∈ Z_4, command index); S crosses edge e and takes the opposite edge
  of the rhomb entered (or exits when no owned rhomb lies there), R: e ← e − 1, L: e ← e + 1.

The orientation of a fine triangle is decided exactly: its legs AB, AC are unit vectors with
C − A = ρ^{±θ}(B − A), θ = 1 (acute) or 3 (obtuse); a triangle of any other shape makes the
check fail.  Directed edges are looked up in the balanced binary search tree `BTree` of the O2
checker on packed integer keys; the checker verifies that the keys are injective on the
coordinates in use, and `BTree.ofList` that no two owned rhombs share a directed edge and that
the tree holds every entry, so a lookup miss really means "no owned rhomb on the far side".

This file is appended to `TurtleO2_template.lean` (namespace `TurtleO2`: Z[ζ] arithmetic,
substitution, certificate structures and index, `portAt`, `BTree`); the data section (`prog`,
`o1Data`) is written by LeanAssist (`LeanTurtleBaseSimulation`, examples/turtle_port_identities.wl).
Standalone Lean 4, no Mathlib; the final theorem `checkO1 cert prog o1Data = true` is checked by
`decide +kernel`.
-/

namespace TurtleO1
open TurtleO2

/-- turtle command -/
inductive Cmd where
  | S
  | R
  | L
deriving Repr, DecidableEq

/-- a rhomb owned by the supertile: vertices in counter-clockwise order,
v0 = apex A of its positive half (A, B, C), v1 = B, v2 = A* = B + C − A, v3 = C -/
structure Quad where
  v0 : Z5
  v1 : Z5
  v2 : Z5
  v3 : Z5
deriving Repr

/-- vertex `e` (mod 4) of the rhomb -/
def Quad.get (q : Quad) (e : Nat) : Z5 :=
  match e % 4 with
  | 0 => q.v0
  | 1 => q.v1
  | 2 => q.v2
  | _ => q.v3

/-- marked fine triangle (col, A, B, C) -/
abbrev Tri := Nat × Z5 × Z5 × Z5

def subdivideAll : List Tri → List Tri
  | [] => []
  | (col, A, B, C) :: ts => subdivide col A B C ++ subdivideAll ts

/-- the fine triangles of the standard level-`B` supertile of type (col, sign) -/
def supertile (col : Nat) (sign : Int) (B : Nat) : List Tri :=
  let (A, Bv, Cv) := stdTriangle col sign
  iter subdivideAll B [(col, A, Bv, Cv)]

/-- orientation of a marked Robinson triangle, decided exactly: the legs AB, AC are unit vectors
with C − A = ρ^θ (B − A) (positive, +1) or C − A = ρ^{−θ} (B − A) (negative, −1), θ = 1 for the
acute and 3 for the obtuse triangle; 0 when the triangle has neither shape -/
def orient (col : Nat) (A B C : Z5) : Int :=
  let θ := if col == 0 then 1 else 3
  let u := Z5.sub B A
  let v := Z5.sub C A
  if Z5.beq v (rotN θ u) then 1 else if Z5.beq v (rotN (10 - θ) u) then -1 else 0

/-- the rhombs owned by the supertile: one per positively oriented fine triangle;
`none` when a fine triangle is malformed -/
def rhombsOf : List Tri → Option (List Quad)
  | [] => some []
  | (col, A, B, C) :: ts =>
    let o := orient col A B C
    if o == 0 then none
    else
      match rhombsOf ts with
      | none => none
      | some qs => if o == 1 then some (⟨A, B, Z5.sub (Z5.add B C) A, C⟩ :: qs) else some qs

/-- packed key of a canonical point whose coordinates lie in (−1024, 1024) (checked by `inRange`) -/
def digit (x : Int) : Nat := Int.toNat (x + 1024)

def pointKey (k : Z5) : Nat :=
  let c := Z5.canon k
  ((digit c.a * 2048 + digit c.b) * 2048 + digit c.c) * 2048 + digit c.d

/-- key of the directed edge tail → head (2048⁴ = 17592186044416) -/
def edgeKey (tail head : Z5) : Nat := pointKey tail * 17592186044416 + pointKey head

def inRange (k : Z5) : Bool :=
  let c := Z5.canon k
  (-1024 < c.a && c.a < 1024) && (-1024 < c.b && c.b < 1024) &&
  (-1024 < c.c && c.c < 1024) && (-1024 < c.d && c.d < 1024)

def Quad.inRange (q : Quad) : Bool :=
  TurtleO1.inRange q.v0 && TurtleO1.inRange q.v1 && TurtleO1.inRange q.v2 && TurtleO1.inRange q.v3

/-- navigation table: key of the directed edge v_e → v_{e+1} ↦ (rhomb, e) -/
abbrev Nav := BTree (Quad × Nat)

def entriesOf : List Quad → List (Nat × (Quad × Nat))
  | [] => []
  | q :: qs =>
    (edgeKey q.v0 q.v1, (q, 0)) :: (edgeKey q.v1 q.v2, (q, 1)) ::
    (edgeKey q.v2 q.v3, (q, 2)) :: (edgeKey q.v3 q.v0, (q, 3)) :: entriesOf qs

/-- the navigation table of the standard level-B supertile of type (col, sign);
`none` when a triangle is malformed, a coordinate is out of the key range, two owned rhombs share
a directed edge, or the tree lost an entry -/
def buildTable (col : Nat) (sign : Int) (B : Nat) : Option Nav :=
  match rhombsOf (supertile col sign B) with
  | none => none
  | some qs => if !(qs.all Quad.inRange) then none else BTree.ofList (entriesOf qs)

/-- state after the entry crossing (tail, head, i): the rhomb with the directed edge head → tail,
heading its opposite edge, next command i + 1; `none` when no owned rhomb lies beyond the leg or
when the rhomb left is owned as well (not an entry) -/
def entryState (t : Nav) (x : Cross) : Option (Quad × Nat × Nat) :=
  match BTree.find t (edgeKey x.head x.tail), BTree.find t (edgeKey x.tail x.head) with
  | some (q, eb), none => some (q, (eb + 2) % 4, x.i + 1)
  | _, _ => none

def nth : List Cmd → Nat → Option Cmd
  | [], _ => none
  | c :: _, 0 => some c
  | _ :: cs, n + 1 => nth cs n

/-- the turtle run: (rhomb q, edge e, command index ci), N S-moves so far; returns the exit crossing
(in the counter-clockwise order of the rhomb left) and the number of S-moves including the exit -/
def run (t : Nav) (prog : List Cmd) : Nat → Quad → Nat → Nat → Nat → Option (Cross × Nat)
  | 0, _, _, _, _ => none
  | fuel + 1, q, e, ci, N =>
    match nth prog (ci % prog.length) with
    | some Cmd.S =>
      let a := q.get e
      let b := q.get (e + 1)
      match BTree.find t (edgeKey b a) with
      | none => some (⟨a, b, ci % prog.length⟩, N + 1)
      | some (q', e2) => run t prog fuel q' ((e2 + 2) % 4) (ci + 1) (N + 1)
    | some Cmd.R => run t prog fuel q ((e + 3) % 4) (ci + 1) N
    | some Cmd.L => run t prog fuel q ((e + 1) % 4) (ci + 1) N
    | none => none

/-- O1 datum: pass family id and its length N(π, B) -/
structure O1Pass where
  id : Nat
  N : Nat
deriving Repr

def tableFor (tbls : List ((Nat × Int) × Nav)) (col : Nat) (sign : Int) : Option Nav :=
  (tbls.find? (fun x => x.1.1 == col && x.1.2 == sign)).map (fun x => x.2)

/-- H(B) for one pass family: entry crossing enters an owned rhomb, exactly N S-moves, the N-th is
the exit port (which leaves the owned rhombs) -/
def checkPassO1 (ix : Idx) (tbls : List ((Nat × Int) × Nav)) (prog : List Cmd) (o : O1Pass) : Bool :=
  match findPass ix o.id with
  | none => false
  | some p =>
    match findPort ix p.id, findPort ix p.out with
    | some pin, some pout =>
      pin.parity == ix.B % 2 &&
      match tableFor tbls pin.col pin.sign with
      | none => false
      | some t =>
        match entryState t (portAt ix.B pin ix.B) with
        | none => false
        | some (q, e, ci) =>
          match run t prog ((o.N + 1) * prog.length) q e ci 0 with
          | some (ex, n) => Cross.beq ex (portAt ix.B pout ix.B) && n == o.N
          | none => false
    | _, _ => false

/-- every pass family of parity B mod 2 has an O1 datum -/
def coversBase (c : Cert) (ix : Idx) (o1 : List O1Pass) : Bool :=
  c.passes.all (fun p =>
    match findPort ix p.id with
    | some pin => pin.parity != ix.B % 2 || o1.any (fun o => o.id == p.id)
    | none => false)

def types : List (Nat × Int) := [(0, 1), (0, -1), (1, 1), (1, -1)]

def checkO1 (c : Cert) (prog : List Cmd) (o1 : List O1Pass) : Bool :=
  match c.index with
  | none => false
  | some ix =>
    prog.length > 0 && prog.any (fun x => x == Cmd.S) &&
    let tbls := types.filterMap (fun ty => (buildTable ty.1 ty.2 ix.B).map (fun t => (ty, t)))
    coversBase c ix o1 && o1.all (checkPassO1 ix tbls prog)

end TurtleO1
/-!
# TurtleO46 -- kernel-checked growth (O4) and exact recurrence (O6) of a pass-substitution certificate

O4 and the computational part of O6 of `proof_unbounded.md`: the lengths
`N(π, m)` of the pass families are defined by `N(π, B)` from the base simulation (O1, the data
`o1Data`) and `N(π, m+1) = Σ_children N(child, m)`.  Along one parity class
`N(m+2) = M N(m)` with the two-level expansion matrix `M` (entry `(π, π')` = multiplicity of
`π'` among the grandchildren of `π`).  For every root family `r` listed in `o6Data` the checker
verifies, with `K = dim M + 3` steps from the first level `m₀` of its parity class:

* O4 (growth): `r` occurs `μ ≥ 1` times in its own two-level expansion, which has more than `μ`
  members (hence `N(r, m+2) ≥ μ N(r, m) + 1` and `N(r, m) → ∞`);
* the two-level identity `N(π, m₀+2s+2) = M N(π, m₀+2s)` for every family `π` of the parity class
  (the vector two levels up, computed level by level, equals the grandchildren sums), `s < K`;
* O6 (closed recurrence): `N(r, m₀) = N₀` and `N(r, m+2) = a N(r, m) + b` for `s < K`.

By `CayleyHamiltonRecurrence.affine_of_initial` (Mathlib) the closed recurrence then holds at
every level of the parity class (`dim M + 1` consecutive steps suffice).

All lengths are recomputed level by level from the pass table (no `N` of the certificate JSON
is trusted).  The families of each parity class are put once into a table (`BTree` on the family
ids, value = the entry ids of the children); the lengths of a level are a tree of the same shape,
computed from the previous level by mapping over the table, and the iteration is a fold that
passes on only the current level.  The O1 data must give `N(π, B)` for every family of parity
`B mod 2` (`baseVec`).  Appended to `TurtleO2_template.lean` and `TurtleO1_template.lean` (`Cert`,
`Idx`, `findPort`, `findPass`, `BTree`, `O1Pass`); the data section (`cert`, `o1Data`, `o6Data`) is
written by LeanAssist (`LeanTurtleRecurrence`, examples/turtle_port_identities.wl).  Standalone
Lean 4, no Mathlib; the theorem `checkO46 cert o1Data o6Data = true` is checked by `decide +kernel`.

Kernel cost: `decide +kernel` keeps every intermediate term of the evaluation in its caches until
the end of the declaration, so its memory grows with the total number of reduction steps, not
with the live data.  The functions evaluated at every level (`get`, `sumOf`, `step`, `twoLevelOK`)
are therefore written with the recursors `BTree.rec` / `List.rec` and the primitive
`Nat.ble` / `Nat.beq` / `Nat.add`: a tree node then costs a few iota steps, about a quarter of
the memory of structural recursion (`brecOn`) with `if`.  The code generator does not support
recursors, so each of them has a structural twin (`…Impl`) that branches in the same way, and a
`@[csimp]` theorem proves the two equal: `native_decide` and `#eval` run the twins.
cert_SRSRSRSRSSR (dim M = 390, 393 steps): 160 s and 15 GB with `decide +kernel` (the previous
version, which rebuilt a sorted tree at every level, exceeded 40 GB).
-/

namespace TurtleO46
open TurtleO2 TurtleO1

/-- O6 datum: a root family, the closed recurrence `N(m+2) = a N(m) + b` of its lengths along its
parity class, and its length `N₀` at the first level `m₀ = R(q)` of the class -/
structure O6Root where
  id : Nat
  a : Int
  b : Int
  N0 : Nat
deriving Repr

/-- the lengths of the families of one parity class at one level, indexed by family id -/
abbrev Lengths := BTree Nat

/-- the families of one parity class: family id ↦ entry ids of its children (with multiplicity) -/
abbrev Table := BTree (List Nat)

/-- the parity of a pass family (that of its entry port) -/
def famParity (ix : Idx) (p : Pass) : Option Nat :=
  (findPort ix p.id).map (·.parity)

/-- the families of parity `q`, in the order of the table -/
def familiesOf (c : Cert) (ix : Idx) (q : Nat) : List Pass :=
  c.passes.filter (fun p => famParity ix p == some q)

/-- the table of the families of parity `q`; `none` when two families share an id -/
def tableOf (c : Cert) (ix : Idx) (q : Nat) : Option Table :=
  BTree.ofList ((familiesOf c ix q).map (fun p => (p.id, p.children.map (·.entry))))

/-- every id of the list is a family of the table `u` -/
def keysIn (u : Table) : List Nat → Bool
  | [] => true
  | id :: ids => (BTree.find u id).isSome && keysIn u ids

/-- the children of every family of the table are families of the table `u` -/
def closedIn (u : Table) : Table → Bool
  | .leaf => true
  | .node l _ chs r => keysIn u chs && closedIn u l && closedIn u r

/-! ## evaluated at every level: recursors for the kernel, structural twins for the compiler -/

/-- the length of family `id` (0 when absent: only used for ids checked by `closedIn`) -/
noncomputable def get (v : Lengths) (id : Nat) : Nat :=
  BTree.rec (motive := fun _ => Nat) 0
    (fun _ key val _ ihl ihr => Bool.rec ihl (Bool.rec ihr val (Nat.beq key id)) (Nat.ble key id)) v

def getImpl (v : Lengths) (id : Nat) : Nat :=
  match v with
  | .leaf => 0
  | .node l key val r => cond (Nat.ble key id) (cond (Nat.beq key id) val (getImpl r id)) (getImpl l id)

@[csimp] theorem get_eq_getImpl : @get = @getImpl := by
  funext v id
  induction v with
  | leaf => rfl
  | node l key val r ihl ihr =>
    show Bool.rec (motive := fun _ => Nat) (get l id)
      (Bool.rec (motive := fun _ => Nat) (get r id) val (Nat.beq key id)) (Nat.ble key id) = _
    rw [ihl, ihr]
    simp only [getImpl]
    cases h1 : Nat.ble key id <;> cases h2 : Nat.beq key id <;> rfl

/-- Σ of the lengths of a list of family ids (with multiplicity) -/
noncomputable def sumOf (v : Lengths) (ids : List Nat) : Nat :=
  List.rec (motive := fun _ => Nat) 0 (fun id _ ih => Nat.add (get v id) ih) ids

def sumOfImpl (v : Lengths) : List Nat → Nat
  | [] => 0
  | id :: ids => Nat.add (get v id) (sumOfImpl v ids)

@[csimp] theorem sumOf_eq_sumOfImpl : @sumOf = @sumOfImpl := by
  funext v ids
  induction ids with
  | nil => rfl
  | cons id ids ih =>
    show Nat.add (get v id) (sumOf v ids) = _
    rw [ih]
    rfl

/-- the lengths one level up, on the table `t` of the other parity class:
`N(π, m+1) = Σ_children N(child, m)`; the result has the shape of `t` -/
noncomputable def step (v : Lengths) (t : Table) : Lengths :=
  BTree.rec (motive := fun _ => Lengths) .leaf
    (fun _ k chs _ ihl ihr => .node ihl k (sumOf v chs) ihr) t

def stepImpl (v : Lengths) : Table → Lengths
  | .leaf => .leaf
  | .node l k chs r => .node (stepImpl v l) k (sumOf v chs) (stepImpl v r)

@[csimp] theorem step_eq_stepImpl : @step = @stepImpl := by
  funext v t
  induction t with
  | leaf => rfl
  | node l k chs r ihl ihr =>
    show BTree.node (step v l) k (sumOf v chs) (step v r) = _
    rw [ihl, ihr]
    rfl

/-- `N(π, m+2) = M N(π, m)` for every family `π`: the vector `v2` two levels up equals the
grandchildren sums of the vector `v` (`g` = rows of `M`, same shape as `v2`) -/
noncomputable def twoLevelOK (v : Lengths) (g : Table) : Lengths → Bool :=
  BTree.rec (motive := fun _ => Lengths → Bool)
    (fun v2 => BTree.casesOn (motive := fun _ => Bool) v2 true (fun _ _ _ _ => false))
    (fun _ k gs _ ihl ihr v2 => BTree.casesOn (motive := fun _ => Bool) v2 false
      (fun l2 k2 n2 r2 =>
        Bool.rec false (Bool.rec false (Bool.rec false (ihr r2) (ihl l2)) (Nat.beq (sumOf v gs) n2))
          (Nat.beq k k2))) g

def twoLevelOKImpl (v : Lengths) : Table → Lengths → Bool
  | .leaf, .leaf => true
  | .leaf, .node .. => false
  | .node .., .leaf => false
  | .node l k gs r, .node l2 k2 n2 r2 =>
    cond (Nat.beq k k2)
      (cond (Nat.beq (sumOf v gs) n2) (cond (twoLevelOKImpl v l l2) (twoLevelOKImpl v r r2) false) false)
      false

@[csimp] theorem twoLevelOK_eq_twoLevelOKImpl : @twoLevelOK = @twoLevelOKImpl := by
  funext v g v2
  induction g generalizing v2 with
  | leaf => cases v2 <;> rfl
  | node l k gs r ihl ihr =>
    cases v2 with
    | leaf => rfl
    | node l2 k2 n2 r2 =>
      show Bool.rec (motive := fun _ => Bool) false
          (Bool.rec (motive := fun _ => Bool) false
            (Bool.rec (motive := fun _ => Bool) false (twoLevelOK v r r2) (twoLevelOK v l l2))
            (Nat.beq (sumOf v gs) n2)) (Nat.beq k k2) = _
      rw [ihl, ihr]
      simp only [twoLevelOKImpl]
      cases h1 : Nat.beq k k2 <;> cases h2 : Nat.beq (sumOf v gs) n2 <;> cases h3 : twoLevelOKImpl v l l2 <;> rfl

/-! ## the tables, the base level and the iteration -/

def childrenIn (u : Table) (id : Nat) : List Nat :=
  match BTree.find u id with
  | some l => l
  | none => []

def grandList (u : Table) : List Nat → List Nat
  | [] => []
  | ch :: chs => childrenIn u ch ++ grandList u chs

/-- the grandchildren (with multiplicity) of every family of `t`, i.e. the rows of the two-level
expansion matrix `M`; same shape as `t` -/
def grand (u : Table) : Table → Table
  | .leaf => .leaf
  | .node l k chs r => .node (grand u l) k (grandList u chs) (grand u r)

/-- the lengths at level B on the table of the families of parity B mod 2, from the O1 data;
`none` when a family has no O1 datum -/
def baseVec (o1t : BTree Nat) : Table → Option Lengths
  | .leaf => some .leaf
  | .node l k _ r =>
    match baseVec o1t l, BTree.find o1t k, baseVec o1t r with
    | some l', some n, some r' => some (.node l' k n r')
    | _, _, _ => none

/-- the grandchildren (entry ids, with multiplicity) of a list of children; `none` when a child
is not a pass family of the table -/
def grandchildren (ix : Idx) : List Child → Option (List Nat)
  | [] => some []
  | ch :: rest =>
    match findPass ix ch.entry, grandchildren ix rest with
    | some p, some tl => some (p.children.map (·.entry) ++ tl)
    | _, _ => none

def count (id : Nat) : List Nat → Nat
  | [] => 0
  | x :: xs => (if x == id then 1 else 0) + count id xs

/-- O4 for one family: it occurs `μ ≥ 1` times in its own two-level expansion, which has more
than `μ` members -/
def growthOK (ix : Idx) (p : Pass) : Bool :=
  match grandchildren ix p.children with
  | some g => count p.id g ≥ 1 && g.length > count p.id g
  | none => false

/-- `k` steps of two levels from the vector `v` of the parity class of the table `tq` (other
class `tq'`, rows of `M` in `gq`): the two-level identity for the whole class and the closed
recurrence of the root at each step.  A fold: only the current level is passed on. -/
def iterate (tq tq' gq : Table) (r : O6Root) : Nat → Lengths → Bool
  | 0, _ => true
  | k + 1, v =>
    let v2 := step (step v tq') tq
    twoLevelOK v gq v2 &&
    ((get v2 r.id : Int) == r.a * (get v r.id : Int) + r.b) &&
    iterate tq tq' gq r k v2

/-- the O1 data indexed by family id; `none` when an id is duplicated -/
def baseLengths (o1 : List O1Pass) : Option (BTree Nat) :=
  BTree.ofList (o1.map (fun o => (o.id, o.N)))

/-- the lengths of the parity class `q` at its first level `m₀ = R(q)`: the O1 data at level B,
one step up when `q ≠ B mod 2` -/
def firstLevel (ix : Idx) (o1t : BTree Nat) (q : Nat) (tq tq' : Table) : Option Lengths :=
  if q == ix.B % 2 then baseVec o1t tq else (baseVec o1t tq').map (fun vB => step vB tq)

/-- O4 and O6 for one root: growth, the tables of both parity classes are closed under children,
`N(r, m₀) = N₀`, and `dim M + 3` steps of the two-level identity and of the closed recurrence -/
def rootOK (c : Cert) (ix : Idx) (o1t : BTree Nat) (r : O6Root) : Bool :=
  match findPass ix r.id with
  | none => false
  | some p =>
    growthOK ix p &&
    match famParity ix p with
    | none => false
    | some q =>
      q < 2 &&
      match tableOf c ix q, tableOf c ix (1 - q) with
      | some tq, some tq' =>
        closedIn tq' tq && closedIn tq tq' && (BTree.find tq r.id).isSome &&
        match firstLevel ix o1t q tq tq' with
        | none => false
        | some v => get v r.id == r.N0 && iterate tq tq' (grand tq' tq) r (tq.size + 3) v
      | _, _ => false

/-- O4 / O6 of the certificate: every root listed in `o6` passes `rootOK` (at least one root);
the O1 data cover the base level (checked by `baseVec`) -/
def checkO46 (c : Cert) (o1 : List O1Pass) (o6 : List O6Root) : Bool :=
  match c.index, baseLengths o1 with
  | some ix, some o1t => o6.length > 0 && o6.all (rootOK c ix o1t)
  | _, _ => false

/-- the lengths `N(r, m₀ + 2 s)` of a root for `s < k` (for `#eval`; not used by the check) -/
def rootLengths (c : Cert) (o1 : List O1Pass) (rid : Nat) (k : Nat) : Option (List Nat) :=
  match c.index, baseLengths o1 with
  | some ix, some o1t =>
    match findPass ix rid with
    | none => none
    | some p =>
      match famParity ix p with
      | none => none
      | some q =>
        match tableOf c ix q, tableOf c ix (1 - q) with
        | some tq, some tq' =>
          let rec go : Nat → Lengths → List Nat
            | 0, _ => []
            | j + 1, v => get v rid :: go j (step (step v tq') tq)
          (firstLevel ix o1t q tq tq').map (go k)
        | _, _ => none
  | _, _ => none

end TurtleO46
