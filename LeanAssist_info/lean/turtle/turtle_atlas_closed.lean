/-!
# TurtleO2 -- kernel-checked verification of a pass-substitution certificate

Checker for the finite obligations of the unboundedness proof of turtle programs on
Penrose rhomb tilings (`proof_unbounded.md`, `verify_cert.py`, `indep_check.py`):

* frames: the child frames (type, rotation k, translation t) of the four standard triangles
  agree with the Robinson-triangle substitution σ (exact arithmetic in Z[ζ]);
* O3: closure / consistency of the pass table (types, parities, children);
* O2: the port identities (a), (b), (c) of every pass family at the two lowest levels of its
  parity class above the base level B.  By Lemma 1 of the proof they then hold at all levels.

Standalone Lean 4 (no Mathlib).  The data section (`cert`) is generated by LeanAssist from the
certificate JSON; the theorem at the end is checked by `decide` (kernel) or `native_decide`.

Port and pass families are looked up through a balanced binary search tree on their ids
(`BTree`, also used by the O1 checker for the directed edges of a supertile): a linear search
over 1560 port families (cert_SRSRSRSRSSR) is too slow for kernel evaluation.  The tree is built
by a fuel-bounded merge sort and a balanced construction (structural recursion only, which the
kernel can evaluate); the checker verifies that the ids are pairwise distinct and that the tree
holds every entry.
-/

namespace TurtleO2

/-- Element of Z[ζ], ζ = e^{2πi/5}, as integer coordinates in the basis 1, ζ, ζ², ζ³, ζ⁴,
taken modulo (1,1,1,1,1).  `canon` makes the last coordinate 0. -/
structure Z5 where
  a : Int
  b : Int
  c : Int
  d : Int
  e : Int
deriving DecidableEq, Repr

namespace Z5

def canon (k : Z5) : Z5 := ⟨k.a - k.e, k.b - k.e, k.c - k.e, k.d - k.e, 0⟩

def add (k l : Z5) : Z5 := canon ⟨k.a + l.a, k.b + l.b, k.c + l.c, k.d + l.d, k.e + l.e⟩

def sub (k l : Z5) : Z5 := canon ⟨k.a - l.a, k.b - l.b, k.c - l.c, k.d - l.d, k.e - l.e⟩

/-- multiplication by φ = 1 + ζ + ζ⁴ : out_j = K_j + K_{j-1} + K_{j+1} -/
def mulphi (k : Z5) : Z5 :=
  canon ⟨k.a + k.e + k.b, k.b + k.a + k.c, k.c + k.b + k.d, k.d + k.c + k.e, k.e + k.d + k.a⟩

/-- multiplication by ρ = -ζ³ (rotation by 36°): out_j = -K_{j-3} -/
def rot36 (k : Z5) : Z5 := canon ⟨-k.c, -k.d, -k.e, -k.a, -k.b⟩

def beq (k l : Z5) : Bool := canon k == canon l

def zero : Z5 := ⟨0, 0, 0, 0, 0⟩

end Z5

def iter {α : Type} (f : α → α) : Nat → α → α
  | 0, x => x
  | n + 1, x => iter f n (f x)

def rotN (k : Nat) (v : Z5) : Z5 := iter Z5.rot36 k v
def phiN (n : Nat) (v : Z5) : Z5 := iter Z5.mulphi n v
def phi2 (v : Z5) : Z5 := Z5.mulphi (Z5.mulphi v)

/-- ρ^k · 1 -/
def unit (k : Nat) : Z5 := rotN k ⟨1, 0, 0, 0, 0⟩

/-- standard marked triangle of type (col, sign): apex 0, then B, C -/
def stdTriangle (col : Nat) (sign : Int) : Z5 × Z5 × Z5 :=
  let b := unit 0
  let c := if col == 0 then unit 1 else unit 3
  if sign > 0 then (Z5.zero, b, c) else (Z5.zero, c, b)

/-- children (col, A, B, C) of a triangle under σ, in slot order (coordinates of the inflated parent) -/
def subdivide (col : Nat) (A B C : Z5) : List (Nat × Z5 × Z5 × Z5) :=
  let A2 := Z5.mulphi A
  let B2 := Z5.mulphi B
  let C2 := Z5.mulphi C
  if col == 0 then
    let P := Z5.add A2 (Z5.sub B A)
    [(0, C2, P, B2), (1, P, C2, A2)]
  else
    let Q := Z5.add B2 (Z5.sub A B)
    let R := Z5.add B2 (Z5.sub C B)
    [(1, R, C2, A2), (1, Q, R, B2), (0, R, Q, A2)]

/-! ## balanced binary search tree on `Nat` keys

Fuel-bounded merge sort and balanced construction, structural recursion only (definitions by
well-founded recursion do not reduce in the kernel).  `ofList` checks that the sorted keys are
strictly increasing (no duplicate key, and enough fuel for the sort) and that the tree holds
every entry (enough fuel for the construction), so a lookup miss means that the key is absent. -/

inductive BTree (α : Type) where
  | leaf
  | node (l : BTree α) (key : Nat) (val : α) (r : BTree α)

namespace BTree

variable {α : Type}

def split : List (Nat × α) → List (Nat × α) × List (Nat × α)
  | [] => ([], [])
  | [x] => ([x], [])
  | x :: y :: tl =>
    let (a, b) := split tl
    (x :: a, y :: b)

def mergeBy : Nat → List (Nat × α) → List (Nat × α) → List (Nat × α)
  | 0, xs, ys => xs ++ ys
  | _ + 1, [], ys => ys
  | _ + 1, xs, [] => xs
  | n + 1, x :: xs, y :: ys =>
    if x.1 ≤ y.1 then x :: mergeBy n xs (y :: ys) else y :: mergeBy n (x :: xs) ys

def msort : Nat → List (Nat × α) → List (Nat × α)
  | 0, xs => xs
  | n + 1, xs =>
    match xs with
    | [] => []
    | [x] => [x]
    | _ =>
      let (a, b) := split xs
      mergeBy xs.length (msort n a) (msort n b)

def sortedStrict : List (Nat × α) → Bool
  | [] => true
  | [_] => true
  | x :: y :: tl => x.1 < y.1 && sortedStrict (y :: tl)

def build : Nat → List (Nat × α) → BTree α
  | 0, _ => leaf
  | n + 1, xs =>
    match xs with
    | [] => leaf
    | _ =>
      let h := xs.length / 2
      match xs.drop h with
      | [] => leaf
      | (k, v) :: rest => node (build n (xs.take h)) k v (build n rest)

def size : BTree α → Nat
  | leaf => 0
  | node l _ _ r => l.size + 1 + r.size

def find (t : BTree α) (k : Nat) : Option α :=
  match t with
  | leaf => none
  | node l key v r => if k < key then find l k else if key < k then find r k else some v

/-- the tree of a key/value list; `none` when two entries share a key -/
def ofList (xs : List (Nat × α)) : Option (BTree α) :=
  let es := msort 64 xs
  if !(sortedStrict es) then none
  else
    let t := build 64 es
    if t.size != es.length then none else some t

end BTree

/-- a crossing: leg tail → head, command index -/
structure Cross where
  tail : Z5
  head : Z5
  i : Nat
deriving Repr

def Cross.beq (x y : Cross) : Bool := Z5.beq x.tail y.tail && Z5.beq x.head y.head && x.i == y.i

/-- port family -/
structure Port where
  id : Nat
  col : Nat
  sign : Int
  parity : Nat
  ref : Cross
  dtail : Z5
  dhead : Z5
deriving Repr

structure Child where
  slot : Nat
  entry : Nat
  exit : Nat
deriving Repr

structure Pass where
  id : Nat
  out : Nat
  children : List Child
deriving Repr

/-- child frame: child = ρ^k (standard child of type (ccol, csign)) + t -/
structure Frame where
  ccol : Nat
  csign : Int
  k : Nat
  t : Z5
deriving Repr

structure Cert where
  B : Nat
  ports : List Port
  passes : List Pass
  frames : List (Nat × Int × List Frame)
deriving Repr

/-- the certificate with its port and pass families indexed by id -/
structure Idx where
  B : Nat
  ports : BTree Port
  passes : BTree Pass
  frames : List (Nat × Int × List Frame)

/-- `none` when two port families or two pass families share an id -/
def Cert.index (c : Cert) : Option Idx :=
  match BTree.ofList (c.ports.map (fun p => (p.id, p))), BTree.ofList (c.passes.map (fun p => (p.id, p))) with
  | some tp, some tq => some { B := c.B, ports := tp, passes := tq, frames := c.frames }
  | _, _ => none

def findPort (ix : Idx) (pid : Nat) : Option Port := BTree.find ix.ports pid
def findPass (ix : Idx) (pid : Nat) : Option Pass := BTree.find ix.passes pid
def findFrames (ix : Idx) (col : Nat) (sign : Int) : Option (List Frame) :=
  (ix.frames.find? (fun f => f.1 == col && f.2.1 == sign)).map (fun f => f.2.2)

/-- lowest level ≥ B of parity q -/
def Rq (B q : Nat) : Nat := if B % 2 == q then B else B + 1

/-- the port at level m (m ≡ q, m ≥ R(q)): x ← φ² x + δ, (m − R(q))/2 times -/
def portAt (B : Nat) (p : Port) (m : Nat) : Cross :=
  let s := (m - Rq B p.parity) / 2
  { tail := iter (fun x => Z5.add (phi2 x) p.dtail) s p.ref.tail,
    head := iter (fun x => Z5.add (phi2 x) p.dhead) s p.ref.head,
    i := p.ref.i }

/-- G_{slot,m} : child frame (level m−1) → parent frame (level m): ρ^k x + φ^{m−1} t -/
def G (fr : Frame) (m : Nat) (x : Z5) : Z5 := Z5.add (rotN fr.k x) (phiN (m - 1) fr.t)

def GCross (fr : Frame) (m : Nat) (x : Cross) : Cross := ⟨G fr m x.tail, G fr m x.head, x.i⟩

/-- the crossing of port `pid` at level m−1, placed into the parent frame through `slot` -/
def placed (ix : Idx) (frs : List Frame) (slot pid m : Nat) : Option Cross :=
  match findPort ix pid, frs[slot]? with
  | some p, some fr => some (GCross fr m (portAt ix.B p (m - 1)))
  | _, _ => none

def crossEq (x y : Option Cross) : Bool :=
  match x, y with
  | some a, some b => Cross.beq a b
  | _, _ => false

/-- identities (b) along the children and (c) at the end -/
def chainOK (ix : Idx) (frs : List Frame) (m : Nat) (outCross : Cross) : Child → List Child → Bool
  | prev, [] => crossEq (some outCross) (placed ix frs prev.slot prev.exit m)
  | prev, nxt :: tl =>
      crossEq (placed ix frs prev.slot prev.exit m) (placed ix frs nxt.slot nxt.entry m) && chainOK ix frs m outCross nxt tl

def checkPassLevel (ix : Idx) (p : Pass) (m : Nat) : Bool :=
  match findPort ix p.id, findPort ix p.out with
  | some pin, some pout =>
    match findFrames ix pin.col pin.sign, p.children with
    | some frs, ch0 :: rest =>
        crossEq (some (portAt ix.B pin m)) (placed ix frs ch0.slot ch0.entry m) &&
        chainOK ix frs m (portAt ix.B pout m) ch0 rest
    | _, _ => false
  | _, _ => false

/-- the two lowest levels of parity q above B -/
def levelsFor (B q : Nat) : List Nat :=
  let m1 := if (B + 1) % 2 == q then B + 1 else B + 2
  [m1, m1 + 2]

def checkPassO2 (ix : Idx) (p : Pass) : Bool :=
  match findPort ix p.id with
  | some pin => (levelsFor ix.B pin.parity).all (checkPassLevel ix p)
  | none => false

def checkO2 (c : Cert) (ix : Idx) : Bool := c.passes.all (checkPassO2 ix)

/-- O3: exit port of the same type and parity; children exist, have the type of their slot and the
opposite parity, their entry is a pass of the table with the stated exit; consecutive slots differ -/
def childOK (ix : Idx) (pin : Port) (frs : List Frame) (ch : Child) : Bool :=
  match findPort ix ch.entry, findPort ix ch.exit, frs[ch.slot]?, findPass ix ch.entry with
  | some a, some b, some fr, some pa =>
      a.col == fr.ccol && a.sign == fr.csign && b.col == fr.ccol && b.sign == fr.csign &&
      a.parity == 1 - pin.parity && b.parity == 1 - pin.parity && pa.out == ch.exit
  | _, _, _, _ => false

def slotsDiffer : List Child → Bool
  | [] => true
  | [_] => true
  | x :: y :: tl => (x.slot != y.slot) && slotsDiffer (y :: tl)

def checkPassO3 (ix : Idx) (p : Pass) : Bool :=
  match findPort ix p.id, findPort ix p.out with
  | some pin, some pout =>
    match findFrames ix pin.col pin.sign with
    | some frs =>
        pin.col == pout.col && pin.sign == pout.sign && pin.parity == pout.parity &&
        p.children.length > 0 && p.children.all (childOK ix pin frs) && slotsDiffer p.children
    | none => false
  | _, _ => false

def checkO3 (c : Cert) (ix : Idx) : Bool := c.passes.all (checkPassO3 ix)

/-- δ is consistent with a unit leg: δ_head − δ_tail = (head − tail) − φ²(head − tail) -/
def portDeltaOK (p : Port) : Bool :=
  let leg := Z5.sub p.ref.head p.ref.tail
  Z5.beq (Z5.sub p.dhead p.dtail) (Z5.sub leg (phi2 leg))

def checkPorts (c : Cert) : Bool := c.ports.all portDeltaOK

/-- frame j describes child j of the standard triangle: A = t, B − A = ρ^k std.B, C − A = ρ^k std.C -/
def frameOK (child : Nat × Z5 × Z5 × Z5) (fr : Frame) : Bool :=
  let (ccol, A, B, C) := child
  let (_, sb, sc) := stdTriangle fr.ccol fr.csign
  ccol == fr.ccol && Z5.beq A fr.t && Z5.beq (Z5.sub B A) (rotN fr.k sb) && Z5.beq (Z5.sub C A) (rotN fr.k sc)

def framesOK (c : Cert) : Bool :=
  c.frames.all (fun f =>
    let (A, B, C) := stdTriangle f.1 f.2.1
    let ch := subdivide f.1 A B C
    ch.length == f.2.2.length && (List.zip ch f.2.2).all (fun x => frameOK x.1 x.2))

def checkCertificate (c : Cert) : Bool :=
  match c.index with
  | none => false
  | some ix => framesOK c && checkPorts c && checkO3 c ix && checkO2 c ix

/-- sanity: φ² = φ + 1 on a sample, ρ^10 = 1 -/
theorem phi_sq_sample : phi2 ⟨2, -3, 0, 1, 0⟩ = Z5.add (Z5.mulphi ⟨2, -3, 0, 1, 0⟩) (Z5.canon ⟨2, -3, 0, 1, 0⟩) := by decide
theorem rot_ten : rotN 10 ⟨2, -3, 0, 1, 0⟩ = Z5.canon ⟨2, -3, 0, 1, 0⟩ := by decide

end TurtleO2
/-!
# TurtleO1 -- kernel-checked base simulation (obligation O1) of a pass-substitution certificate

O1 of `proof_unbounded.md`: for every pass family π of parity B mod 2, in the standard level-B
supertile X of type τ(π), the crossing port(π.in, B) leads into a rhomb owned by X; starting
there the turtle performs exactly N(π, B) S-moves, the first N − 1 between rhombs owned by X, and
the N-th is the crossing port(π.out, B), which leads to a rhomb not owned by X.

Everything is recomputed from the definitions (same specification as `verify_cert.py`,
class `Supertile`, and `lib.wl`, `ptRhombs "Ghost" -> True` / `ptNav`):

* the fine triangles of X: `subdivide` applied B times to the standard marked triangle;
* ownership: every positively oriented fine triangle (A, B, C) owns the rhomb (A, B, B + C − A, C)
  (its mirror half is the ghost half when the negative triangle is not in X);
* navigation by directed edge keys: the rhomb on the far side of the leg a → b is the one that has
  the directed edge b → a in its counter-clockwise order;
* turtle: state (rhomb, edge e ∈ Z_4, command index); S crosses edge e and takes the opposite edge
  of the rhomb entered (or exits when no owned rhomb lies there), R: e ← e − 1, L: e ← e + 1.

The orientation of a fine triangle is decided exactly: its legs AB, AC are unit vectors with
C − A = ρ^{±θ}(B − A), θ = 1 (acute) or 3 (obtuse); a triangle of any other shape makes the
check fail.  Directed edges are looked up in the balanced binary search tree `BTree` of the O2
checker on packed integer keys; the checker verifies that the keys are injective on the
coordinates in use, and `BTree.ofList` that no two owned rhombs share a directed edge and that
the tree holds every entry, so a lookup miss really means "no owned rhomb on the far side".

This file is appended to `TurtleO2_template.lean` (namespace `TurtleO2`: Z[ζ] arithmetic,
substitution, certificate structures and index, `portAt`, `BTree`); the data section (`prog`,
`o1Data`) is written by LeanAssist (`LeanTurtleBaseSimulation`, examples/turtle_port_identities.wl).
Standalone Lean 4, no Mathlib; the final theorem `checkO1 cert prog o1Data = true` is checked by
`decide +kernel`.
-/

namespace TurtleO1
open TurtleO2

/-- turtle command -/
inductive Cmd where
  | S
  | R
  | L
deriving Repr, DecidableEq

/-- a rhomb owned by the supertile: vertices in counter-clockwise order,
v0 = apex A of its positive half (A, B, C), v1 = B, v2 = A* = B + C − A, v3 = C -/
structure Quad where
  v0 : Z5
  v1 : Z5
  v2 : Z5
  v3 : Z5
deriving Repr

/-- vertex `e` (mod 4) of the rhomb -/
def Quad.get (q : Quad) (e : Nat) : Z5 :=
  match e % 4 with
  | 0 => q.v0
  | 1 => q.v1
  | 2 => q.v2
  | _ => q.v3

/-- marked fine triangle (col, A, B, C) -/
abbrev Tri := Nat × Z5 × Z5 × Z5

def subdivideAll : List Tri → List Tri
  | [] => []
  | (col, A, B, C) :: ts => subdivide col A B C ++ subdivideAll ts

/-- the fine triangles of the standard level-`B` supertile of type (col, sign) -/
def supertile (col : Nat) (sign : Int) (B : Nat) : List Tri :=
  let (A, Bv, Cv) := stdTriangle col sign
  iter subdivideAll B [(col, A, Bv, Cv)]

/-- orientation of a marked Robinson triangle, decided exactly: the legs AB, AC are unit vectors
with C − A = ρ^θ (B − A) (positive, +1) or C − A = ρ^{−θ} (B − A) (negative, −1), θ = 1 for the
acute and 3 for the obtuse triangle; 0 when the triangle has neither shape -/
def orient (col : Nat) (A B C : Z5) : Int :=
  let θ := if col == 0 then 1 else 3
  let u := Z5.sub B A
  let v := Z5.sub C A
  if Z5.beq v (rotN θ u) then 1 else if Z5.beq v (rotN (10 - θ) u) then -1 else 0

/-- the rhombs owned by the supertile: one per positively oriented fine triangle;
`none` when a fine triangle is malformed -/
def rhombsOf : List Tri → Option (List Quad)
  | [] => some []
  | (col, A, B, C) :: ts =>
    let o := orient col A B C
    if o == 0 then none
    else
      match rhombsOf ts with
      | none => none
      | some qs => if o == 1 then some (⟨A, B, Z5.sub (Z5.add B C) A, C⟩ :: qs) else some qs

/-- packed key of a canonical point whose coordinates lie in (−1024, 1024) (checked by `inRange`) -/
def digit (x : Int) : Nat := Int.toNat (x + 1024)

def pointKey (k : Z5) : Nat :=
  let c := Z5.canon k
  ((digit c.a * 2048 + digit c.b) * 2048 + digit c.c) * 2048 + digit c.d

/-- key of the directed edge tail → head (2048⁴ = 17592186044416) -/
def edgeKey (tail head : Z5) : Nat := pointKey tail * 17592186044416 + pointKey head

def inRange (k : Z5) : Bool :=
  let c := Z5.canon k
  (-1024 < c.a && c.a < 1024) && (-1024 < c.b && c.b < 1024) &&
  (-1024 < c.c && c.c < 1024) && (-1024 < c.d && c.d < 1024)

def Quad.inRange (q : Quad) : Bool :=
  TurtleO1.inRange q.v0 && TurtleO1.inRange q.v1 && TurtleO1.inRange q.v2 && TurtleO1.inRange q.v3

/-- navigation table: key of the directed edge v_e → v_{e+1} ↦ (rhomb, e) -/
abbrev Nav := BTree (Quad × Nat)

def entriesOf : List Quad → List (Nat × (Quad × Nat))
  | [] => []
  | q :: qs =>
    (edgeKey q.v0 q.v1, (q, 0)) :: (edgeKey q.v1 q.v2, (q, 1)) ::
    (edgeKey q.v2 q.v3, (q, 2)) :: (edgeKey q.v3 q.v0, (q, 3)) :: entriesOf qs

/-- the navigation table of the standard level-B supertile of type (col, sign);
`none` when a triangle is malformed, a coordinate is out of the key range, two owned rhombs share
a directed edge, or the tree lost an entry -/
def buildTable (col : Nat) (sign : Int) (B : Nat) : Option Nav :=
  match rhombsOf (supertile col sign B) with
  | none => none
  | some qs => if !(qs.all Quad.inRange) then none else BTree.ofList (entriesOf qs)

/-- state after the entry crossing (tail, head, i): the rhomb with the directed edge head → tail,
heading its opposite edge, next command i + 1; `none` when no owned rhomb lies beyond the leg or
when the rhomb left is owned as well (not an entry) -/
def entryState (t : Nav) (x : Cross) : Option (Quad × Nat × Nat) :=
  match BTree.find t (edgeKey x.head x.tail), BTree.find t (edgeKey x.tail x.head) with
  | some (q, eb), none => some (q, (eb + 2) % 4, x.i + 1)
  | _, _ => none

def nth : List Cmd → Nat → Option Cmd
  | [], _ => none
  | c :: _, 0 => some c
  | _ :: cs, n + 1 => nth cs n

/-- the turtle run: (rhomb q, edge e, command index ci), N S-moves so far; returns the exit crossing
(in the counter-clockwise order of the rhomb left) and the number of S-moves including the exit -/
def run (t : Nav) (prog : List Cmd) : Nat → Quad → Nat → Nat → Nat → Option (Cross × Nat)
  | 0, _, _, _, _ => none
  | fuel + 1, q, e, ci, N =>
    match nth prog (ci % prog.length) with
    | some Cmd.S =>
      let a := q.get e
      let b := q.get (e + 1)
      match BTree.find t (edgeKey b a) with
      | none => some (⟨a, b, ci % prog.length⟩, N + 1)
      | some (q', e2) => run t prog fuel q' ((e2 + 2) % 4) (ci + 1) (N + 1)
    | some Cmd.R => run t prog fuel q ((e + 3) % 4) (ci + 1) N
    | some Cmd.L => run t prog fuel q ((e + 1) % 4) (ci + 1) N
    | none => none

/-- O1 datum: pass family id and its length N(π, B) -/
structure O1Pass where
  id : Nat
  N : Nat
deriving Repr

def tableFor (tbls : List ((Nat × Int) × Nav)) (col : Nat) (sign : Int) : Option Nav :=
  (tbls.find? (fun x => x.1.1 == col && x.1.2 == sign)).map (fun x => x.2)

/-- H(B) for one pass family: entry crossing enters an owned rhomb, exactly N S-moves, the N-th is
the exit port (which leaves the owned rhombs) -/
def checkPassO1 (ix : Idx) (tbls : List ((Nat × Int) × Nav)) (prog : List Cmd) (o : O1Pass) : Bool :=
  match findPass ix o.id with
  | none => false
  | some p =>
    match findPort ix p.id, findPort ix p.out with
    | some pin, some pout =>
      pin.parity == ix.B % 2 &&
      match tableFor tbls pin.col pin.sign with
      | none => false
      | some t =>
        match entryState t (portAt ix.B pin ix.B) with
        | none => false
        | some (q, e, ci) =>
          match run t prog ((o.N + 1) * prog.length) q e ci 0 with
          | some (ex, n) => Cross.beq ex (portAt ix.B pout ix.B) && n == o.N
          | none => false
    | _, _ => false

/-- every pass family of parity B mod 2 has an O1 datum -/
def coversBase (c : Cert) (ix : Idx) (o1 : List O1Pass) : Bool :=
  c.passes.all (fun p =>
    match findPort ix p.id with
    | some pin => pin.parity != ix.B % 2 || o1.any (fun o => o.id == p.id)
    | none => false)

def types : List (Nat × Int) := [(0, 1), (0, -1), (1, 1), (1, -1)]

def checkO1 (c : Cert) (prog : List Cmd) (o1 : List O1Pass) : Bool :=
  match c.index with
  | none => false
  | some ix =>
    prog.length > 0 && prog.any (fun x => x == Cmd.S) &&
    let tbls := types.filterMap (fun ty => (buildTable ty.1 ty.2 ix.B).map (fun t => (ty, t)))
    coversBase c ix o1 && o1.all (checkPassO1 ix tbls prog)

end TurtleO1
/-!
# TurtleBounded -- kernel-checked atlas closure and bounded runs V(P, n)

The finite part of the boundedness proof of turtle programs on Penrose rhomb tilings
(`proof_sketch.md`, `prove2.py`, `subst_fast.py`, `notebook_src/check_atlas.wl`):

* **Step 1, atlas closure** (`checkAtlas`).  An atlas entry is a marked triangle corona: a centre
  triangle `t_C` and all triangles sharing a vertex with it, given in the frame of the centre.
  The checker verifies that every entry is the corona of its centre (complete: the angles around
  each vertex of the centre sum to 360°, in integer units of 36°; every triangle touches the
  centre), that the entries are pairwise inequivalent, and, for every child `t′ ⊂ σ(t_C)`, that
  the corona of `t′` inside `σ(C)` is complete and its canonical form is one of the entries.
  Canonical form (as `ptCoronaCanon` in `lib.wl`): translate the apex of the centre to 0, rotate
  by the multiple of 36° that turns its leg AB to direction 0, pack every triangle (colour,
  centre flag, vertices) into one `Nat` and sort.  Equal forms ⇔ the marked coronas agree up to
  translation and rotation by a multiple of 36°.
* **Step 2, V(P, n)** (`checkCorona`, `checkBounded`).  For every entry `C`, every fine triangle
  `t` of `σⁿ(t_C)` (enumerated by the checker) and every heading `e ∈ Z₄`, the state
  (rhomb of `t`, `e`) lies on a closed orbit of the program `P` (states compared after whole
  cycles) whose rhombs are rhombs of the patch `σⁿ(C)`, and the set of minimal periods is the
  stated one.  The certificate written by Mathematica gives
  - the rhombs used by the orbits, each as the addresses of its two triangles in `σⁿ(C)`
    (`root · 3ⁿ + Σ slotᵢ 3ⁿ⁻ⁱ`: triangle `root` of the corona, then child `slotᵢ` at level `i`);
    the checker recomputes both triangles by `n` substitutions and requires a positively oriented
    triangle and its mirror image across the common base (`rhombOf`, the merge of `merge_v`);
  - one representative state per orbit with its period; the checker runs whole cycles of `P`
    from it, requires that the state after cycle `p` (and no earlier cycle) is the start, and that
    every S-move enters a rhomb of the certificate (otherwise: an escape, the check fails);
  - the period set.
  The states met after whole cycles are collected in a search tree (`BTree.ofList`: orbits are
  disjoint), and every start state must be found there; its period must belong to the stated set,
  and every stated period must occur.

Rhombs are `TurtleO1.Quad` (counter-clockwise, `v0` = apex of the positive half), navigation is
by directed edge keys as in the O1 checker, here with 16-bit coordinate digits (`wEdgeKey`,
range checked by `wInRange`) so that levels up to n = 10 fit.  A state is identified by the key
of its directed edge `v_e → v_{e+1}`, which is injective because no two rhombs of the table share
a directed edge (checked by `BTree.ofList`).

Appended to `TurtleO2_template.lean` and `TurtleO1_template.lean` (`Z5`, `subdivide`, `rotN`,
`unit`, `BTree`, `Tri`, `subdivideAll`, `orient`, `Quad`, `Cmd`, `Nav`); the data section
(`atlas`, `certs`, ...) is written by LeanAssist (examples/turtle_bounded.wl).  Standalone Lean 4,
no Mathlib.  `checkAtlas atlas = true` by `decide +kernel`; `checkBounded prog n atlas certs
periods = true` by `native_decide`, or by `decide +kernel` one corona per theorem.

Not checked here (facts of the argument): the entries are legal coronas (they come from
`σ⁸(sun)`), the geometric lemma corona(t′) ⊂ σ(corona(u)) for t′ ⊂ σ(u), repetitivity (F2), and
that every triangle of a tiling is paired with its mirror image (F3).
-/

namespace TurtleBounded
open TurtleO2 TurtleO1

/-! ## keys with 16-bit coordinate digits -/

/-- digit of a coordinate in (−32768, 32768) (checked by `wInRange`) -/
def wDigit (x : Int) : Nat := Int.toNat (x + 32768)

def wPointKey (k : Z5) : Nat :=
  let c := Z5.canon k
  ((wDigit c.a * 65536 + wDigit c.b) * 65536 + wDigit c.c) * 65536 + wDigit c.d

def wInRange (k : Z5) : Bool :=
  let c := Z5.canon k
  (-32768 < c.a && c.a < 32768) && (-32768 < c.b && c.b < 32768) &&
  (-32768 < c.c && c.c < 32768) && (-32768 < c.d && c.d < 32768)

/-- key of the directed edge tail → head (65536⁴ = 18446744073709551616) -/
def wEdgeKey (tail head : Z5) : Nat := wPointKey tail * 18446744073709551616 + wPointKey head

/-! ## coronas and the atlas closure (Step 1) -/

/-- angle of a marked triangle of colour `col` at its vertex A (`role` 0), B (1), C (2), in units
of 36°: acute (36°, 72°, 72°), obtuse (108°, 36°, 36°) -/
def angleUnits (col role : Nat) : Nat :=
  if col == 0 then (if role == 0 then 1 else 2) else (if role == 0 then 3 else 1)

/-- the total angle at the point `v` of the triangles of `ts` that have `v` as a vertex -/
def angleAt (ts : List Tri) (v : Z5) : Nat :=
  ts.foldl (fun s u =>
    let (col, A, B, C) := u
    s + (if Z5.beq A v then angleUnits col 0 else 0) + (if Z5.beq B v then angleUnits col 1 else 0) +
      (if Z5.beq C v then angleUnits col 2 else 0)) 0

/-- the angles of the triangles of `ts` around each vertex of `t` sum to 360° -/
def completeAt (ts : List Tri) (t : Tri) : Bool :=
  let (_, A, B, C) := t
  angleAt ts A == 10 && angleAt ts B == 10 && angleAt ts C == 10

def hasVertex (u : Tri) (v : Z5) : Bool :=
  let (_, A, B, C) := u
  Z5.beq A v || Z5.beq B v || Z5.beq C v

/-- `u` shares a vertex with `t` -/
def touches (t u : Tri) : Bool :=
  let (_, A, B, C) := t
  hasVertex u A || hasVertex u B || hasVertex u C

def triEq (t u : Tri) : Bool :=
  t.1 == u.1 && Z5.beq t.2.1 u.2.1 && Z5.beq t.2.2.1 u.2.2.1 && Z5.beq t.2.2.2 u.2.2.2

/-- the `k ∈ {0, …, 9}` with `ρᵏ · 1 = d` -/
def unitIndex (d : Z5) : Option Nat := (List.range 10).find? (fun k => Z5.beq (unit k) d)

/-- the triangle `u` translated by `−A0` and rotated by `ρʳ` -/
def toFrame (A0 : Z5) (r : Nat) (u : Tri) : Tri :=
  let (col, A, B, C) := u
  (col, rotN r (Z5.sub A A0), rotN r (Z5.sub B A0), rotN r (Z5.sub C A0))

def triOK (u : Tri) : Bool :=
  let (col, A, B, C) := u
  Nat.ble col 1 && wInRange A && wInRange B && wInRange C

/-- key of a triangle: centre flag, colour, then its three vertices (2⁶⁴ = 18446744073709551616) -/
def triKey (flag : Bool) (u : Tri) : Nat :=
  let (col, A, B, C) := u
  ((((if flag then 2 else 0) + col) * 18446744073709551616 + wPointKey A) * 18446744073709551616 +
    wPointKey B) * 18446744073709551616 + wPointKey C

/-- canonical form of the marked patch `ts` around the triangle `t` (up to translation and rotation
by multiples of 36°): the sorted keys of its triangles in the frame of `t`, `t` flagged.  `none`
when the leg AB of `t` is not a unit vector, a triangle is malformed or a triangle is repeated. -/
def canonOf (ts : List Tri) (t : Tri) : Option (List Nat) :=
  let (_, A0, B0, _) := t
  match unitIndex (Z5.sub B0 A0) with
  | none => none
  | some k =>
    let fr := ts.map (fun u => (triEq u t, toFrame A0 ((10 - k) % 10) u))
    if !(fr.all (fun x => triOK x.2)) then none
    else
      let es := BTree.msort 64 (fr.map (fun x => (triKey x.1 x.2, ())))
      if BTree.sortedStrict es && es.length == ts.length then some (es.map (·.1)) else none

/-- an atlas entry: the triangles of a corona, in the frame of the centre `tris[centre]` -/
structure Corona where
  tris : List Tri
  centre : Nat
deriving Repr

def Corona.centreTri (C : Corona) : Option Tri := C.tris[C.centre]?

/-- the entry is the corona of its centre: complete around the centre, every triangle touches it -/
def Corona.wellFormed (C : Corona) : Bool :=
  match C.centreTri with
  | none => false
  | some t => completeAt C.tris t && C.tris.all (touches t)

def Corona.form (C : Corona) : Option (List Nat) :=
  match C.centreTri with
  | none => none
  | some t => canonOf C.tris t

/-- the canonical form of the corona of `t'` inside the patch `ts`; `none` when it is incomplete -/
def coronaForm (ts : List Tri) (t' : Tri) : Option (List Nat) :=
  if completeAt ts t' then canonOf (ts.filter (touches t')) t' else none

/-- the coronas of the children of the centre inside σ(C) -/
def Corona.childForms (C : Corona) : List (Option (List Nat)) :=
  match C.centreTri with
  | none => [none]
  | some (col, A, B, Cv) => (subdivide col A B Cv).map (coronaForm (subdivideAll C.tris))

def memForm (fs : List (List Nat)) (f : List Nat) : Bool := fs.any (fun g => g == f)

def distinctForms : List (List Nat) → Bool
  | [] => true
  | f :: fs => !(memForm fs f) && distinctForms fs

/-- Step 1: every entry is the corona of its centre, the entries are pairwise inequivalent, and
the coronas of the children of every centre are complete inside σ(C) and equivalent to entries -/
def checkAtlas (atlas : List Corona) : Bool :=
  let fs := atlas.filterMap Corona.form
  atlas.length > 0 && fs.length == atlas.length && atlas.all Corona.wellFormed && distinctForms fs &&
  atlas.all (fun C => C.childForms.all (fun o =>
    match o with
    | some f => memForm fs f
    | none => false))

/-! ## search trees from certified orders

Sorting is expensive in the kernel (a fuel-bounded merge sort of 3276 entries takes about 17 s).
The certificate therefore lists the entries of every search tree in increasing key order; the
checker verifies that the keys (which it computes itself) are strictly increasing and builds the
balanced tree in one pass (`buildBal`), so the tree is a search tree.  An entry left out only
makes a lookup fail. -/

/-- lookup in a search tree, written with the recursor and `Nat.ble` / `Nat.beq` (cheap kernel
reduction; same result as `BTree.find`); `tfindImpl` is the structural twin for the compiler -/
noncomputable def tfind {α : Type} (t : BTree α) (k : Nat) : Option α :=
  BTree.rec (motive := fun _ => Option α) none
    (fun _ key v _ ihl ihr => Bool.rec ihl (Bool.rec ihr (some v) (Nat.beq key k)) (Nat.ble key k)) t

def tfindImpl {α : Type} (t : BTree α) (k : Nat) : Option α :=
  match t with
  | .leaf => none
  | .node l key v r => cond (Nat.ble key k) (cond (Nat.beq key k) (some v) (tfindImpl r k)) (tfindImpl l k)

@[csimp] theorem tfind_eq_tfindImpl : @tfind = @tfindImpl := by
  funext α t k
  induction t with
  | leaf => rfl
  | node l key v r ihl ihr =>
    show Bool.rec (motive := fun _ => Option α) (tfind l k)
      (Bool.rec (motive := fun _ => Option α) (tfind r k) (some v) (Nat.beq key k)) (Nat.ble key k) = _
    rw [ihl, ihr]
    simp only [tfindImpl]
    cases h1 : Nat.ble key k <;> cases h2 : Nat.beq key k <;> rfl

/-- the balanced tree of the first `k` entries of `xs` (in their order) and the remaining entries;
the fuel `f` bounds the depth -/
def buildBal {α : Type} : Nat → Nat → List (Nat × α) → BTree α × List (Nat × α)
  | 0, _, xs => (.leaf, xs)
  | _ + 1, 0, xs => (.leaf, xs)
  | f + 1, k + 1, xs =>
    match buildBal f (k / 2) xs with
    | (l, []) => (l, [])
    | (l, (key, v) :: rest) =>
      match buildBal f (k - k / 2) rest with
      | (r, rest') => (.node l key v r, rest')

/-- the search tree of a list of entries in strictly increasing key order; `none` otherwise -/
def treeOfSorted {α : Type} (xs : List (Nat × α)) : Option (BTree α) :=
  if BTree.sortedStrict xs then some (buildBal 64 xs.length xs).1 else none

def indexed {α : Type} : Nat → List α → List (Nat × α)
  | _, [] => []
  | i, x :: xs => (i, x) :: indexed (i + 1) xs

/-- the search tree of a list indexed by position -/
def indexTree {α : Type} (xs : List α) : BTree α := (buildBal 64 xs.length (indexed 0 xs)).1

/-! ## fine triangles and rhombs of σⁿ(C) -/

/-- `(root, [slot₁, …, slotₙ])` of the address `code = root · 3ⁿ + Σ slotᵢ 3ⁿ⁻ⁱ`: the triangle
`root` of the patch, then the child `slotᵢ` at level `i` (coarsest first) -/
def splitAddr : Nat → Nat → List Nat → Nat × List Nat
  | 0, c, acc => (c, acc)
  | k + 1, c, acc => splitAddr k (c / 3) (c % 3 :: acc)

/-- the descendants of `t` along the slots, one per level -/
def fresh : Tri → List Nat → Option (List Tri)
  | _, [] => some []
  | (col, A, B, C), s :: ss =>
    match (subdivide col A B C)[s]? with
    | none => none
    | some t => (fresh t ss).map (t :: ·)

/-- the descendants of `t` along the slots `ss`, reusing the descendants `as` of `t` along `os`
for the common prefix of `ss` and `os` -/
def share : Tri → List Nat → List Nat → List Tri → Option (List Tri)
  | t, s :: ss, o :: os, a :: as => if s == o then (share a ss os as).map (a :: ·) else fresh t (s :: ss)
  | t, ss, _, _ => fresh t ss

def lastOr : Tri → List Tri → Tri
  | t, [] => t
  | _, a :: as => lastOr a as

/-- the fine triangles of σⁿ(patch) with the given addresses, from the previous address (root,
slots, descendants) on: consecutive addresses share the descendants of their common prefix (the
certificate lists the addresses in increasing order; any order gives the same triangles) -/
def fineTris (ts : List Tri) (n : Nat) : List Nat → Option Nat → List Nat → List Tri → Option (List Tri)
  | [], _, _, _ => some []
  | code :: cs, prevRoot, prevSlots, prevDesc =>
    let (root, slots) := splitAddr n code []
    match ts[root]? with
    | none => none
    | some t =>
      match (if prevRoot == some root then share t slots prevSlots prevDesc else fresh t slots) with
      | none => none
      | some ds =>
        match fineTris ts n cs (some root) slots ds with
        | none => none
        | some tl => some (lastOr t ds :: tl)

/-- the rhomb (A, B, A*, C), A* = B + C − A, of a positively oriented triangle `p` = (col, A, B, C)
and its mirror image `q` = (col, A*, B, C) across the base BC; `none` otherwise -/
def rhombOf (p q : Tri) : Option Quad :=
  let (col, A, B, C) := p
  let (col', A', B', C') := q
  let As := Z5.sub (Z5.add B C) A
  if orient col A B C == 1 && col == col' && Z5.beq A' As && Z5.beq B' B && Z5.beq C' C then
    some ⟨A, B, As, C⟩
  else none

/-- the rhomb that contains the fine triangle `u` (with its mirror image across the base) -/
def rhombOfTri (u : Tri) : Option Quad :=
  let (col, A, B, C) := u
  let As := Z5.sub (Z5.add B C) A
  let o := orient col A B C
  if o == 1 then some ⟨A, B, As, C⟩ else if o == -1 then some ⟨As, B, A, C⟩ else none

def pairsOf : List Nat → List (Nat × Nat)
  | a :: b :: tl => (a, b) :: pairsOf tl
  | _ => []

def triplesOf : List Nat → List (Nat × Nat × Nat)
  | a :: b :: c :: tl => (a, b, c) :: triplesOf tl
  | _ => []

/-- the rhombs of the certificate: pairs of fine triangles (indices into the tree `ft`) -/
def rhombsOfPairs (ft : BTree Tri) : List (Nat × Nat) → Option (List Quad)
  | [] => some []
  | (a, b) :: tl =>
    match tfind ft a, tfind ft b, rhombsOfPairs ft tl with
    | some p, some q, some qs => (rhombOf p q).map (· :: qs)
    | _, _, _ => none

def Quad.wInRange (q : Quad) : Bool :=
  TurtleBounded.wInRange q.v0 && TurtleBounded.wInRange q.v1 &&
  TurtleBounded.wInRange q.v2 && TurtleBounded.wInRange q.v3

/-- a rhomb by the keys of its vertices (counter-clockwise, as in `Quad`); the keys are injective
on points in range, so the turtle runs on keys only -/
structure KQuad where
  k0 : Nat
  k1 : Nat
  k2 : Nat
  k3 : Nat
deriving Repr

def KQuad.get (q : KQuad) (e : Nat) : Nat :=
  match e % 4 with
  | 0 => q.k0
  | 1 => q.k1
  | 2 => q.k2
  | _ => q.k3

def Quad.keys (q : Quad) : KQuad := ⟨wPointKey q.v0, wPointKey q.v1, wPointKey q.v2, wPointKey q.v3⟩

/-- key of the state (rhomb, heading e): the key `wEdgeKey` of its directed edge v_e → v_{e+1} -/
def stateKey (q : KQuad) (e : Nat) : Nat := q.get e * 18446744073709551616 + q.get (e + 1)

/-- navigation table: key of the directed edge v_e → v_{e+1} ↦ (rhomb, e) -/
abbrev KNav := BTree (KQuad × Nat)

/-! ## orbits (Step 2) -/

/-- one cycle of the program from (q, e); `none` when an S-move would leave the rhombs of the table -/
def cycleRun (t : KNav) : List Cmd → KQuad → Nat → Option (KQuad × Nat)
  | [], q, e => some (q, e)
  | Cmd.S :: cs, q, e =>
    match tfind t (q.get (e + 1) * 18446744073709551616 + q.get e) with
    | none => none
    | some (q', e2) => cycleRun t cs q' ((e2 + 2) % 4)
  | Cmd.R :: cs, q, e => cycleRun t cs q ((e + 3) % 4)
  | Cmd.L :: cs, q, e => cycleRun t cs q ((e + 1) % 4)

/-- the state with key `key` is the claimed state `(o, j)` (the state after `j` cycles of orbit `o`) -/
def claimIs (st : BTree (Nat × Nat)) (key o j : Nat) : Bool :=
  match tfind st key with
  | some (o', j') => Nat.beq o' o && Nat.beq j' j
  | none => false

/-- `k` more cycles of orbit `o` from its `j`-th state (q, e): every state met before the last cycle
differs from the start (key `key0`) and is the claimed state `(o, j)`; the last cycle returns to
the start -/
def orbitOK (nav : KNav) (st : BTree (Nat × Nat)) (prog : List Cmd) (o key0 : Nat) :
    Nat → Nat → KQuad → Nat → Bool
  | 0, _, _, _ => false
  | k + 1, j, q, e =>
    match cycleRun nav prog q e with
    | none => false
    | some (q', e') =>
      let key := stateKey q' e'
      match k with
      | 0 => key == key0
      | i + 1 => !(key == key0) && claimIs st key o j && orbitOK nav st prog o key0 (i + 1) (j + 1) q' e'

/-- the orbits of the certificate, `(4 · rhomb index + e, period)`, from orbit number `o` on:
each is closed with the stated minimal period, and its states are the claimed ones -/
def orbitsOK (nav : KNav) (st : BTree (Nat × Nat)) (tr : BTree KQuad) (prog : List Cmd) :
    Nat → List (Nat × Nat) → Bool
  | _, [] => true
  | o, (s, p) :: tl =>
    match tfind tr (s / 4) with
    | none => false
    | some q =>
      let key0 := stateKey q (s % 4)
      claimIs st key0 o 0 && orbitOK nav st prog o key0 p 1 q (s % 4) && orbitsOK nav st tr prog (o + 1) tl

/-- navigation entries (key, (rhomb, e)) of the state codes `4 · rhomb index + e` -/
def navList (tr : BTree KQuad) : List Nat → Option (List (Nat × (KQuad × Nat)))
  | [] => some []
  | s :: ss =>
    match tfind tr (s / 4), navList tr ss with
    | some q, some tl => some ((stateKey q (s % 4), (q, s % 4)) :: tl)
    | _, _ => none

/-- claimed states (key, (orbit, cycle)) of the triples `(4 · rhomb index + e, o, j)` -/
def claimList (tr : BTree KQuad) : List (Nat × Nat × Nat) → Option (List (Nat × (Nat × Nat)))
  | [] => some []
  | (s, o, j) :: ts =>
    match tfind tr (s / 4), claimList tr ts with
    | some q, some tl => some ((stateKey q (s % 4), (o, j)) :: tl)
    | _, _ => none

/-- the keys of the four states of the rhombs of the fine triangles `us` -/
def startKeys : List Tri → Option (List Nat)
  | [] => some []
  | u :: us =>
    match rhombOfTri u, startKeys us with
    | some q, some ks =>
      if Quad.wInRange q then
        let k := Quad.keys q
        some (stateKey k 0 :: stateKey k 1 :: stateKey k 2 :: stateKey k 3 :: ks)
      else none
    | _, _ => none

def sumPeriods : List (Nat × Nat) → Nat
  | [] => 0
  | (_, p) :: tl => p + sumPeriods tl

/-! ## the certificate of a corona

The lists of a certificate hold thousands of numbers; written as list literals they make
elaboration and compilation slow (the compiler spent 10 minutes on the literals of V(SSR, 7)).
They are therefore packed into a few large numbers (written in hexadecimal): a chunk is
`h + 2³² · Σ dᵢ 2^(w (i − 1))` with the header `h = 64 · count + w` (digits `d₁, …, d_count` of
`w` bits), a packed list is a list of chunks.  Division, remainder and powers of `Nat` literals
are evaluated by GMP in the kernel and in compiled code. -/

/-- the `k` lowest digits of `x` in base `b`, least significant first -/
def digitsIn (b : Nat) : Nat → Nat → List Nat
  | 0, _ => []
  | k + 1, x => x % b :: digitsIn b k (x / b)

/-- the numbers of a packed list -/
def unpack : List Nat → List Nat
  | [] => []
  | c :: cs =>
    let h := c % 4294967296
    digitsIn (2 ^ (h % 64)) (h / 64) (c / 4294967296) ++ unpack cs

/-- the certificate of one corona (packed lists, see `unpack`):
* `fine`: the addresses of the fine triangles used, in increasing order;
* `rhombs`: pairs (positive triangle, mirror image) of indices into `fine`; rhomb `r` is the `r`-th pair;
* `orbits`: pairs (`4 r + e` of the representative state, period); orbit `o` is the `o`-th pair;
* `nav`: the states `4 r + e` of the navigation table, by increasing key;
* `states`: triples (`4 r + e`, `o`, `j`): the state after `j` cycles of orbit `o`, by increasing key;
* `periods` (not packed): the set of periods of the start states. -/
structure CoronaCert where
  fine : List Nat
  rhombs : List Nat
  orbits : List Nat
  nav : List Nat
  states : List Nat
  periods : List Nat
deriving Repr

/-- the rhombs of the certificate, as rhombs of σⁿ(C) with their vertex keys -/
def certRhombs (C : Corona) (n : Nat) (cert : CoronaCert) : Option (List KQuad) :=
  match fineTris C.tris n (unpack cert.fine) none [] [] with
  | none => none
  | some fs =>
    match rhombsOfPairs (indexTree fs) (pairsOf (unpack cert.rhombs)) with
    | none => none
    | some qs => if qs.all Quad.wInRange then some (qs.map Quad.keys) else none

/-- V(P, n) for one corona: every state of every rhomb of σⁿ(t_C) is a claimed state; the claimed
states are exactly the states of the orbits of the certificate (matched one to one by orbit and
cycle number); each orbit is closed with the stated minimal period inside the rhombs of σⁿ(C) of
the certificate (no escape); the periods of the start states form the stated set -/
def checkCorona (prog : List Cmd) (n : Nat) (C : Corona) (cert : CoronaCert) : Bool :=
  match C.centreTri, certRhombs C n cert with
  | some (col, A, B, Cv), some ks =>
    let tr := indexTree ks
    let cl := triplesOf (unpack cert.states)
    match navList tr (unpack cert.nav), claimList tr cl with
    | some nl, some sl =>
      match treeOfSorted nl, treeOfSorted sl with
      | some nav, some st =>
        let os := pairsOf (unpack cert.orbits)
        if !(orbitsOK nav st tr prog 0 os && cl.length == sumPeriods os) then false
        else
          match startKeys (iter subdivideAll n [(col, A, B, Cv)]) with
          | none => false
          | some sk =>
            let to := indexTree (os.map (·.2))
            let ps := sk.map (fun k => (tfind st k).bind (fun x => tfind to x.1))
            ps.all (fun o =>
              match o with
              | some p => cert.periods.contains p
              | none => false) &&
            cert.periods.all (fun p => ps.contains (some p))
      | _, _ => false
    | _, _ => false
  | _, _ => false

def allCoronas (prog : List Cmd) (n : Nat) : List Corona → List CoronaCert → Bool
  | [], [] => true
  | C :: cs, d :: ds => checkCorona prog n C d && allCoronas prog n cs ds
  | _, _ => false

def unionPeriods (certs : List CoronaCert) : List Nat :=
  certs.foldl (fun acc d => d.periods.foldl (fun a p => if a.contains p then a else p :: a) acc) []

def samePeriods (xs ys : List Nat) : Bool := xs.all ys.contains && ys.all xs.contains

/-- the computational part of the boundedness proof of `(prog)*` at level `n`: the atlas is closed
(Step 1) and V(P, n) holds for every corona of the atlas (Step 2), with the stated period set -/
def checkBounded (prog : List Cmd) (n : Nat) (atlas : List Corona) (certs : List CoronaCert)
    (periods : List Nat) : Bool :=
  checkAtlas atlas && allCoronas prog n atlas certs && samePeriods (unionPeriods certs) periods

end TurtleBounded
